{
  "name": "otp-autofill",
  "displayName": "OTP Autofill",
  "version": "0.3.1",
  "private": true,
  "description": "Privacy-first Gmail verification codes, filled on sites you approve.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/finalize-build.mjs",
    "build:local": "npm run build && npm run sync:local",
    "sync:local": "node scripts/sync-local.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests test-site scripts *.ts *.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:site": "node scripts/test-server.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run test:e2e",
    "companion": "node scripts/start-companion.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tldts": "^7.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.1.32",
    "@types/node": "^22.19.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "type": "module"
}
